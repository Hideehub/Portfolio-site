# Copy to .env for local development. .env is read automatically and is git-ignored.
# On Render, set these in the service's Environment tab instead.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, with scheme, e.g. https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=

# Leave unset locally to use SQLite. In production, the Neon connection string:
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Optional: change the admin path, e.g. manage-7f3k/ (keep the trailing slash)
ADMIN_URL=admin/

# Contact form notifications. Without EMAIL_HOST, messages are saved but no email is sent
# (with DEBUG=True they're printed to the runserver console instead).
CONTACT_RECIPIENT_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
